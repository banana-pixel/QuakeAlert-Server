# Nginx server block template for QuakeAlert.
# Copy to your nginx config (e.g. /etc/nginx/sites-available/) and adjust server_name
# and SSL paths if your domain or Certbot paths differ.
#
# IMPORTANT: You must define limit_req_zone for "chat_limit" in your main nginx config
# (inside the http { } block). See RECOVERY.md section 2.

server {
    server_name quakealert.bananapixel.my.id;

    # --- 1. NTFY (MAIN SERVICE) ---
    location / {
        proxy_pass http://127.0.0.1:8080;

        proxy_http_version 1.1;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_read_timeout 24h;

        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # --- 2. FLASK (REPORT API) ---
    location /laporan {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # --- FLASK (STATIONS API) ---
    location /stations {
        proxy_pass http://127.0.0.1:5000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    # --- 3. CHAT SERVER (SOCKET.IO) ---
    location ^~ /socket.io/ {
        if ($http_user_agent ~* (curl|wget|python|libwww-perl)) {
            return 403;
        }

        limit_req zone=chat_limit burst=5 nodelay;

        proxy_pass http://localhost:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;

        proxy_set_header Accept-Encoding "";
        proxy_set_header Gzip off;
        proxy_buffering off;
        proxy_request_buffering off;
        tcp_nodelay on;
    }

    listen 443 ssl;
    ssl_certificate /etc/letsencrypt/live/quakealert.bananapixel.my.id/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/quakealert.bananapixel.my.id/privkey.pem;
    include /etc/letsencrypt/options-ssl-nginx.conf;
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem;
}

# Redirect HTTP to HTTPS
server {
    if ($host = quakealert.bananapixel.my.id) {
        return 301 https://$host$request_uri;
    }
    listen 80;
    server_name quakealert.bananapixel.my.id;
    return 404;
}
